---
import { Image } from 'astro:assets';
import "../styles/navigation.css";
import logo from '../assets/images/brand/waldo-mark.png';

const navItems = [
  { title: "Inicio", label: "inicio", url: "#inicio" },
  { title: "Experiencia", label: "experiencia", url: "#experiencia" },
  { title: "Proyectos", label: "proyectos", url: "#proyectos" },
  { title: "Sobre mí", label: "sobre-mi", url: "#sobre-mi" },
  { title: "Contacto", label: "contacto", url: "#contacto" },
];
---

<header class="site-header" id="site-header">
  <nav
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a
        href="#inicio"
        class="nav-logo"
        aria-label="Portafolio de Waldo Fernández - Ir al inicio"
      >
        <span class="nav-logo__mark">
          <Image
            src={logo}
            alt="Logo Waldo Fernández"
            class="nav-logo__img"
            widths={[40, 48]}
            sizes={`(max-width: 767px) 40px, 48px`}
            loading="eager"
            fetchpriority="high"
          />
        </span>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden md:flex items-center gap-1" role="list">
        {
          navItems.map((link) => (
            <li>
              <a
                href={link.url}
                class="nav-link px-4 py-2 text-sm font-medium"
                data-section={link.label}
                aria-label={`Ir a la sección ${link.title}`}
              >
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile Toggle: tres líneas que se transforman en una X -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle inline-flex h-10 w-10 items-center justify-center rounded-full md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <span class="nav-toggle-line" aria-hidden="true"></span>
        <span class="nav-toggle-line" aria-hidden="true"></span>
        <span class="nav-toggle-line" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu md:hidden">
    <ul
      class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6 lg:px-8"
      role="list"
    >
      {
        navItems.map((link, index) => (
          <li style={`--i: ${index}`}>
            <a
              href={link.url}
              class="mobile-nav-link block rounded-lg px-4 py-3 text-base font-medium"
              data-section={link.label}
              aria-label={`Ir a la sección ${link.title}`}
            >
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script src="../scripts/navigation.ts"></script>
