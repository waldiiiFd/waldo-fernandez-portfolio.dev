---
import "../styles/experience.css";
import Image from "astro/components/Image.astro";
import type { CollectionEntry } from "astro:content";
import { getTechIcon } from "../utils/techIcons";

interface Props {
  experience: CollectionEntry<"experience">[];
  education: CollectionEntry<"education">[];
}

const { experience, education } = Astro.props;

const jobs = experience;
const educationList = education;

---

<section id="experiencia" class="wp-exp" aria-label="Sección de experiencia">
  <div class="wp-exp__container">
    <h2 class="wp-exp__title">Experiencia & Educación</h2>

    <div class="wp-exp__content">
      <!-- Experiencia Laboral -->
      <div class="wp-exp__section">
        <h3 class="wp-exp__section-title">Experiencia Profesional</h3>
        <div class="wp-exp__timeline">
          {
            jobs.map((job, index) => (
              <article class="wp-exp__card" data-index={index} data-reveal>
                <div class="wp-exp__card-inner">
                  <div class="wp-exp__card-meta">
                    <h4 class="wp-exp__card-title">
                      {job.data.title}
                      {job.data.current && (
                        <span class="wp-exp__card-badge">Actual</span>
                      )}
                    </h4>
                    <p class="wp-exp__card-company">{job.data.company}</p>
                    <p class="wp-exp__card-period">{job.data.period}</p>
                  </div>
                  <div class="wp-exp__card-details">
                    <p class="wp-exp__card-description">
                      {job.data.description}
                    </p>
                    {job.data.technologies &&
                      job.data.technologies.length > 0 && (
                        <div class="wp-exp__tags">
                          {job.data.technologies.map((tech) => {
                            const iconUrl = getTechIcon(tech);
                            return (
                              <span class="wp-exp__tag">
                                {iconUrl && (
                                  <Image
                                    src={iconUrl}
                                    alt=""
                                    aria-hidden="true"
                                    class="wp-exp__tag-icon"
                                    width="14"
                                    height="14"
                                    loading="lazy"
                                  />
                                )}
                                {tech}
                              </span>
                            );
                          })}
                        </div>
                      )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Educación -->
      <div class="wp-exp__section">
        <h3 class="wp-exp__section-title">Formación Académica</h3>
        <div class="wp-exp__timeline">
          {
            educationList.map((edu, index) => (
              <article
                class="wp-exp__card"
                data-index={index + jobs.length}
                data-reveal
              >
                <div class="wp-exp__card-inner">
                  <div class="wp-exp__card-meta">
                    <h4 class="wp-exp__card-title">{edu.data.institution}</h4>
                    <p class="wp-exp__card-period">{edu.data.period}</p>
                  </div>
                  <div class="wp-exp__card-details">
                    <p class="wp-exp__card-description">
                      {edu.data.description}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
