---
import "../styles/hero.css";
import { Image } from "astro:assets";
import mobileImageSrc from "../assets/images/hero/developer-desk-at-night-mobile.webp";
import desktopImageSrc from "../assets/images/hero/developer-desk-at-night.webp";

interface HeroData {
  name: string;
  role: string;
  description: string;
  ctas?: Array<{
    label: string;
    href: string;
    variant: "primary" | "outline";
  }>;
  specialties?: Array<{
    title: string;
    description: string;
    icon: string;
  }>;
}

const hero: HeroData = {
  name: "Waldo Fernández",
  role: "Ingeniero de Software",
  description:
    "Mi enfoque se centra en el desarrollo de aplicaciones web modernas y eficientes, entregando soluciones robustas e intuitivas que impulsan el éxito de cada proyecto",
  ctas: [
    { label: "Contáctame", href: "#contacto", variant: "primary" },
    { label: "Ver mi trabajo", href: "#proyectos", variant: "outline" },
  ],
  specialties: [
    {
      title: "Frontend",
      description:
        "Vue, Astro, TypeScript, HTML, CSS, JavaScript. Creando interfaces modernas y responsivas.",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="2" y="3" width="20" height="14" rx="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
        <circle cx="7" cy="10" r="1"/>
        <circle cx="12" cy="10" r="1"/>
        <circle cx="17" cy="10" r="1"/>
      </svg>`,
    },
    {
      title: "Backend",
      description:
        "Node.js, Laravel, NestJS. REST APIs. Construyendo soluciones robustas y escalables.",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="2" y="2" width="20" height="8" rx="2"/>
        <rect x="2" y="14" width="20" height="8" rx="2"/>
        <line x1="6" y1="6" x2="6" y2="6"/>
        <line x1="6" y1="18" x2="6" y2="18"/>
      </svg>`,
    },
    {
      title: "Base de Datos",
      description:
        "MariaDB, PostgreSQL, MySQL. Gestión y optimización eficiente de datos.",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <ellipse cx="12" cy="5" rx="9" ry="3"/>
        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
      </svg>`,
    },
    {
      title: "DevOps",
      description:
        "Git, CI/CD, Docker, Bash. Manteniendo código de calidad.",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 1v4"/>
        <path d="M12 19v4"/>
        <path d="M4.22 4.22l2.83 2.83"/>
        <path d="M16.95 16.95l2.83 2.83"/>
        <path d="M1 12h4"/>
        <path d="M19 12h4"/>
        <path d="M4.22 19.78l2.83-2.83"/>
        <path d="M16.95 7.05l2.83-2.83"/>
      </svg>`,
    },
  ],
};

const { name, role, description, ctas, specialties } = hero;
---

<section id="inicio" class="wp-hero" aria-label="Sección de inicio">
  <picture class="wp-hero__bg" aria-hidden="true" role="presentation">
    <source
      media="(max-width: 767px)"
      srcset={mobileImageSrc.src}
      type="image/webp"
      width="768"
      height="1024"
    />
    <Image
      src={desktopImageSrc}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      width={1920}
      height={1080}
    />
  </picture>
  <div class="wp-hero__overlay" aria-hidden="true"></div>

  <!-- Contenido principal -->
  <div
    class="wp-hero__content mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center gap-6"
    data-reveal-group
  >
    <!-- Título -->
    <h1 class="wp-hero__title">
      Hola, soy {name}
    </h1>

    <!-- Rol / Badge -->
    <span class="wp-hero__role">
      {role}
    </span>

    <!-- Descripción -->
    <p class="wp-hero__description max-w-2xl">
      {description}
    </p>

    <!-- CTAs -->
    {
      ctas && ctas.length > 0 && (
        <div class="wp-hero__ctas flex flex-wrap justify-center gap-4 mt-2">
          {ctas.map((cta) => (
            <a
              href={cta.href}
              class:list={[
                "wp-hero__cta",
                cta.variant === "primary"
                  ? "wp-hero__cta--primary"
                  : "wp-hero__cta--outline",
              ]}
            >
              {cta.label}
            </a>
          ))}
        </div>
      )
    }

    <!-- Specialties -->
    {
      specialties && specialties.length > 0 && (
        <div class="wp-hero__specialties grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 w-full max-w-4xl">
          {specialties.map((specialty) => (
            <div class="wp-hero__specialty flex flex-col items-center gap-3 p-4 rounded-lg bg-white/5 backdrop-blur-sm border border-white/10 hover:border-white/20 transition-colors">
              <div class="wp-hero__specialty-icon" set:html={specialty.icon} />
              <div class="text-center">
                <span class="wp-hero__specialty-title text-sm font-semibold block">
                  {specialty.title}
                </span>
                <p class="wp-hero__specialty-desc text-xs mt-1">
                  {specialty.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>