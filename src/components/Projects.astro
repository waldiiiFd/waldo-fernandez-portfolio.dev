---
import type { CollectionEntry } from "astro:content";
import ProjectsCarousel from "./ProjectsCarousel.astro";
import "../styles/projects.css";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="proyectos" class="wp-projects" aria-label="Sección de proyectos">
  <div class="wp-projects__container">
    <h2 class="wp-projects__title" data-reveal>Proyectos destacados</h2>

    <div class="wp-projects__wrapper">
      <ProjectsCarousel projects_projects_to_projectsCarousel={projects} intervalMs={3000} />
    </div>
  </div>
</section>
